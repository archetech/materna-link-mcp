{
  "name": "@maternalink/mcp-server",
  "version": "1.0.0",
  "description": "MaternaLink MCP — Healthcare identity verification for AI agents. Verify patients, caregivers, and medical teams using Archon decentralized identity. HIPAA-aware, FHIR-ready, stateless by design.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "maternalink-mcp": "dist/index.js",
    "maternalink-mcp-http": "dist/server-http.js"
  },
  "files": [
    "dist",
    "demos",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "node dist/server-http.js",
    "dev": "npx tsx src/index.ts",
    "dev:http": "npx tsx src/server-http.ts",
    "build": "tsc && chmod 755 dist/index.js dist/server-http.js",
    "demo:patient": "npx tsx demos/demo-patient.ts",
    "demo:delegation": "npx tsx demos/demo-delegation.ts",
    "demo:team": "npx tsx demos/demo-team.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "maternalink",
    "maternal-health",
    "healthcare",
    "obgyn",
    "pregnancy",
    "did",
    "decentralized-identity",
    "verifiable-credentials",
    "fhir",
    "hipaa",
    "sharp",
    "ai-agents",
    "ssi",
    "archon"
  ],
  "author": "Archetech <info@archetech.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archetech/materna-link-mcp.git"
  },
  "homepage": "https://archon.technology",
  "bugs": {
    "url": "https://github.com/archetech/materna-link-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.2",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  }
}